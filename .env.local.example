# Supabase Configuration
# Get these from your Supabase project settings:
# 1. Go to https://app.supabase.com
# 2. Create a new project or select existing one
# 3. Go to Settings > API Keys
# 4. Copy the anon key and project URL

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional guardrail: if set, the frontend will refuse to run if the URL points
# at a different Supabase project ref.
# Example: for https://qvcnk...supabase.co use:
# NEXT_PUBLIC_SUPABASE_PROJECT_REF=qvcnk...
NEXT_PUBLIC_SUPABASE_PROJECT_REF=your-project-ref

# Optional: USDA FoodData Central API key for very large food database coverage
# Get one free at: https://fdc.nal.usda.gov/api-key-signup.html
# If omitted, the app will still use built-in foods + OpenFoodFacts live search.
USDA_API_KEY=your-usda-api-key-here

# Optional: FatSecret OAuth 2 credentials for additional food search coverage.
# These stay server-side and are never sent to the browser.
FATSECRET_CLIENT_ID=your-fatsecret-client-id
FATSECRET_CLIENT_SECRET=your-fatsecret-client-secret

# API Ninjas - live recipe search
# Get a free key at: https://api-ninjas.com
API_NINJAS_KEY=your-api-ninjas-key-here
